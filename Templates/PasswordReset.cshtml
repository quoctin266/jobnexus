@model JobNexus.Dtos.Email.PasswordResetDto

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Reset your password</title>
    <style>
        body { background-color: #ffffff; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; color: #333333; margin: 0; padding: 0; }
        .container { width: 100%; max-width: 600px; margin: 40px auto; padding: 20px; }
        .card { border-radius: 6px; padding: 36px 40px; text-align: center; }
        .brand { color: #e66a2c; font-size: 36px; font-weight: 600; margin-bottom: 18px; }
        h1 { font-size: 20px; margin: 0 0 24px 0; font-weight: 600; }
        p { color: #6b6b6b; line-height: 1.5; }
        .btn { display: inline-block; background-color: #e66a2c; color: #ffffff !important; text-decoration: none; padding: 12px 26px; border-radius: 6px; font-weight: 600; margin: 16px 0; }
        .link { word-break: break-all; color: #1a73e8; }
        .muted { color: #9b9b9b; font-size: 12px; margin-top: 26px; }
        .content { background: #ffffff; }
    </style>
</head>
<body>
    <div class="container">
        <div class="card content">
            <div class="brand">@Model?.CompanyName</div>

            <h1>Hi @Model?.Username, let's reset your password.</h1>

            <a class="btn" href="@Model?.ResetUrl" target="_blank" rel="noopener noreferrer">Reset Your Password</a>

            <p>If the above button does not work for you, copy and paste the following into your browser's address bar:</p>

            <p class="link">@Model?.ResetUrl</p>

            <p class="muted">If you didn't ask to reset your password, you can safely disregard this email.</p>
        </div>
    </div>
</body>
</html>