@model JobNexus.Dtos.Email.ConfirmEmailDto

<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verify your email</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background:#f3f4f6; margin:0; padding:20px; }
    .card { max-width:600px; margin:24px auto; background:#ffffff; border-radius:8px; overflow:hidden; border:1px solid rgba(2,6,23,0.06); }
    .header { background:linear-gradient(90deg,#ff6a00,#ff8a00); padding:36px 24px; text-align:center; color:#fff; }
    .header img { max-width:120px; }
    .content { padding:32px 28px; color:#333; text-align:center; }
    h1 { margin:0 0 12px; font-size:24px; }
    .subtitle { color:#6b7280; margin-bottom:18px; }
    .company { color:#0ea5a4; font-weight:600; text-decoration:none; }
    .message { color:#374151; line-height:1.5; margin:18px 0 24px; }
    .button-wrap { text-align:center; margin:22px 0; }
    .btn { display:inline-block; background:linear-gradient(90deg,#ff6a00,#ff8a00); color:#fff !important; padding:14px 28px; border-radius:30px; text-decoration:none; font-weight:700; }
    .note { color:#9ca3af; font-size:13px; margin:18px 0 28px; }
    .footer { padding:18px 24px; text-align:center; color:#9ca3af; font-size:12px; }
  </style>
</head>
<body>
  <div class="card">
    <div class="header">
      <img src="https://quoctinmedia.blob.core.windows.net/jobnexus/mail.png" alt="Mail icon" width="88" height="88" />
    </div>

    <div class="content">
      <h1>Verify your email address</h1>
      <div class="subtitle">Welcome to <a class="company" href="@(Model?.CompanyUrl ?? "https://jodbak.com")" target="_blank">@(Model?.CompanyName ?? "jodbak.com")</a></div>

      <p class="message">Please click the button below to confirm your email address and activate your account.</p>

      <div class="button-wrap">
        <a class="btn" href="@(Model?.ConfirmationUrl ?? "#")" target="_blank" rel="noopener">CONFIRM EMAIL</a>
      </div>

      <div class="note">If you received this in error, simply ignore this email and do not click the button.</div>
    </div>

    <div class="footer">&copy; 2026 @(Model?.CompanyName ?? "jodbak.com"). All rights reserved.</div>
  </div>
</body>
</html>
